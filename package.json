{
  "name": "thriftshoewear-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "thriftshoewear Admin Dashboard built with Next.js App Router, React 19, Tailwind CSS v4, and Redux Toolkit.",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --import ./scripts/tests/register-loader.mjs --test scripts/tests/*.test.mjs",
    "test:contracts": "node --import ./scripts/tests/register-loader.mjs --test scripts/tests/nextjs-config.test.mjs scripts/tests/api-and-state.test.mjs scripts/tests/architecture-and-hygiene.test.mjs",
    "test:unit": "node --import ./scripts/tests/register-loader.mjs --test scripts/tests/redux-store.test.mjs",
    "test:ssr": "node --import ./scripts/tests/register-loader.mjs --test scripts/tests/routes-and-views.test.mjs scripts/tests/superadmin-controls.test.mjs",
    "test:bundle": "node --test scripts/ci/bundle-budget.test.mjs",
    "test:e2e": "node scripts/e2e/run-dashboard-e2e.mjs",
    "test:security": "node --test tests/security-hardening.test.mjs",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@reduxjs/toolkit": "^2.15.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.81.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.95.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
